<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.BATTERY_STATS" />
    <!-- 系统时钟的 SET_ALARM 处理者要求的权限名是 com.android.alarm.permission.SET_ALARM。
         原先写成不存在的 android.permission.SET_ALARM，应用发给时钟的意图每次都被 Permission Denial 拒绝
         （2026-10-19 真机回执取证），闹钟全部退到会被 vivo 冻结的助手闹钟 -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- 到点提醒：Android 13+ 安装即授予的精确定时权限（侧载分发不受商店政策限制） -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 心跳每一拍持短时唤醒锁（闹钟只保证叫醒一瞬间） -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Android 11+ 包可见性：要先查出有哪些应用能处理"设闹钟"，才能把意图直接发给时钟（见 ClockPicker） -->
    <queries>
        <provider android:authorities="com.vivo.weather.provider" />
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <!-- 专注模式进阶档：让用户从已安装的应用里勾选"分心应用" -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:extractNativeLibs="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AiChatSample"
        >

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
            <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".FocusActivity"
            android:exported="true"
            android:parentActivityName=".MainActivity" />
        <service
            android:name=".FocusService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="focus mode timer and distraction detection" />
        </service>
        <activity
            android:name=".MemoryActivity"
            android:exported="true"
            android:parentActivityName=".SettingsActivity" />
        <service
            android:name=".HeartbeatService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="personal assistant proactive heartbeat" />
        </service>
        <!-- 模型推理独立进程：原生内存不在主进程账上（见 docs/方案-推理独立进程）；客户端全部解绑后自行结束进程 -->
        <service
            android:name=".LlmService"
            android:exported="false"
            android:process=":llm" />
        <!-- 仅用于冻结实验 E2（调试用，不参与正式功能） -->
        <service
            android:name=".ProbeJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".ReminderBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- 仅调试包生效的端到端测试钩子；DUMP 权限只有 adb shell 拥有 -->
        <receiver
            android:name=".TestHookReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.minicpm.assistant.E2E" />
                <action android:name="com.minicpm.assistant.E2E_CHAT" />
                <action android:name="com.minicpm.assistant.E2E_HB" />
                <action android:name="com.minicpm.assistant.E2E_ALARM" />
                <action android:name="com.minicpm.assistant.E2E_PROBE" />
                <action android:name="com.minicpm.assistant.E2E_EVENT" />
                <action android:name="com.minicpm.assistant.E2E_TYPE" />
                <action android:name="com.minicpm.assistant.E2E_CAND" />
                <action android:name="com.minicpm.assistant.E2E_FOCUS" />
                <action android:name="com.minicpm.assistant.E2E_WPROBE" />
                <action android:name="com.minicpm.assistant.E2E_WEATHER" />
                <action android:name="com.minicpm.assistant.E2E_STEPS" />
                <action android:name="com.minicpm.assistant.E2E_REMIND" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
